# What `lumberjack serve` and the Docker image read. Copy to .env, which is never committed.

# Required: the key that signs session tokens. The server refuses to start without one.
LUMBERJACK_JWT_SECRET=

# Required the first time a database is created: the admin account's password. No default.
LUMBERJACK_ADMIN_PASS=

# The address the server listens on. Unset means 127.0.0.1; the Docker image sets 0.0.0.0.
LUMBERJACK_HOST=

# Optional encryption at rest: unset stores plaintext; `kms` needs CORRESPONDER_STORAGE_KMS_KEY,
# `local-test` needs CORRESPONDER_STORAGE_LOCAL_KEY_FILE (a private 32-byte file).
CORRESPONDER_STORAGE_MODE=
