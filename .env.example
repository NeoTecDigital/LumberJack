# LumberJack Database Configuration
# Copy this file to .env and configure with your values
# DO NOT commit .env to version control

DB_TYPE=sqlite
DB_PATH=./lumberjack.db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lumberjack
DB_USER=your_db_user_here
DB_PASSWORD=your_db_password_here

# Server Configuration
SERVER_PORT=3000
SERVER_HOST=localhost

# Session Configuration
SESSION_SECRET=your_session_secret_here_use_long_random_string
SESSION_DURATION=24h

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/lumberjack.log